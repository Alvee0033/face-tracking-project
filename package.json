{
    "name": "iiuc-nextjs",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apis",
        "web"
    ],
    "scripts": {
        "dev:api": "npm run start:dev --workspace=apis",
        "dev:web": "npm run dev --workspace=web",
        "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}
